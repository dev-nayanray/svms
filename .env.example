# Euroscope — Environment Variables
# Copy this file to .env and fill in your values.

# MongoDB connection string (REQUIRED)
# Local MongoDB: mongodb://localhost:27017/euroscope
# MongoDB Atlas:  mongodb+srv://username:password@cluster.mongodb.net/euroscope
DATABASE_URL=mongodb://localhost:27017/euroscope

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-char-string

# App branding (optional — defaults shown)
NEXT_PUBLIC_APP_NAME=Euroscope
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_THEME_COLOR=#1e293b

# Seed demo passwords (optional — defaults shown)
SEED_ADMIN_PASSWORD=Admin@12345
SEED_EMPLOYEE_PASSWORD=Employee@12345
SEED_STUDENT_PASSWORD=Student@12345

# ── AI Student Assistant ──────────────────────────────────────────
# The AI provider config. The API key is server-only — it is NEVER
# sent to the browser. The browser talks to /api/student/assistant/*
# which talks to the AI provider on the server.
#
# Default provider: OpenAI (gpt-4o-mini).
# To use Azure OpenAI, OpenRouter, LM Studio, Ollama, vLLM, or any
# Hermes API that exposes an OpenAI-compatible endpoint, set
# AI_PROVIDER_BASE_URL to the provider's base URL.
#
# To disable the assistant entirely: AI_ASSISTANT_ENABLED=false
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini
AI_ASSISTANT_ENABLED=true

# ── Telegram Bot ──────────────────────────────────────────────────
# Get a bot token from @BotFather: https://t.me/BotFather
# Create a webhook secret: openssl rand -hex 32
#
# After setting these, register the webhook:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://your-domain.com/api/telegram/webhook?secret=<SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
