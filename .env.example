# Euroscope — Environment Variables
# Copy this file to .env and fill in your values.

# MongoDB connection string (REQUIRED)
# Local MongoDB: mongodb://localhost:27017/euroscope
# MongoDB Atlas:  mongodb+srv://username:password@cluster.mongodb.net/euroscope
DATABASE_URL=mongodb://localhost:27017/euroscope

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-char-string

# App branding (optional — defaults shown)
NEXT_PUBLIC_APP_NAME=Euroscope
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_THEME_COLOR=#1e293b

# Seed demo passwords (optional — defaults shown)
SEED_ADMIN_PASSWORD=Admin@12345
SEED_EMPLOYEE_PASSWORD=Employee@12345
SEED_STUDENT_PASSWORD=Student@12345
