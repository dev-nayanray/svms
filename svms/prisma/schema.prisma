generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Identity & RBAC
// ─────────────────────────────────────────────

model Role {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       @unique // ADMIN | EMPLOYEE | STUDENT
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  key      String   @unique // e.g. "students.read"
  roleName String
  role     Role     @relation(fields: [roleName], references: [name])
}

model User {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String        @unique
  phone            String?
  passwordHash     String
  roleName         String        @default("STUDENT")
  role             Role          @relation(fields: [roleName], references: [name])
  status           String        @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED | PENDING
  avatar           String?
  lastLoginAt      DateTime?
  emailVerifiedAt  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  student          Student?
  employee         Employee?

  @@index([roleName])
}

// ─────────────────────────────────────────────
// People
// ─────────────────────────────────────────────

model Student {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String    @unique @db.ObjectId
  user               User      @relation(fields: [userId], references: [id])
  studentId          String    @unique // STD-YYYY-NNNNNN
  firstName          String
  lastName           String
  email              String
  phone              String?
  dateOfBirth        DateTime?
  gender             String?
  nationality        String?
  country            String?
  city               String?
  address            String?
  postalCode         String?
  // Passport (sensitive — masked in the UI by default; reveal requires explicit click)
  passportNumber     String?
  passportIssueDate  DateTime?
  passportExpiryDate DateTime?
  passportIssuingCountry String?
  assignedEmployeeId String?   @db.ObjectId
  assignedEmployee   Employee? @relation("AssignedStudents", fields: [assignedEmployeeId], references: [id])
  status             String    @default("ACTIVE")
  applications       Application[]
  documents          Document[]
  tasks              Task[]
  conversations      Conversation[]
  appointments       Appointment[]
  payments           Payment[]
  invoices           Invoice[]
  academicRecords    AcademicRecord[]
  englishProficiencies EnglishProficiency[]
  notes              Note[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([assignedEmployeeId])
  @@index([status])
}

model Employee {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @unique @db.ObjectId
  user      User      @relation(fields: [userId], references: [id])
  title     String?
  students  Student[] @relation("AssignedStudents")
  leads     Lead[]
  conversations Conversation[]
  appointments Appointment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Lead {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  phone              String?
  email              String?
  interestedCountry  String?
  status             String    @default("NEW") // NEW | CONTACTED | COUNSELING | QUALIFIED | CONVERTED | LOST
  source             String?
  notes              String?
  assignedEmployeeId String?   @db.ObjectId
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id])
  convertedStudentId String?   @db.ObjectId
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([assignedEmployeeId])
}

// ─────────────────────────────────────────────
// Education catalog
// ─────────────────────────────────────────────

model Country {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  code        String    @unique
  flag        String?
  currency    String?
  status      String    @default("ACTIVE")
  description String?
  universities University[]
  applications Application[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model University {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String    @unique
  countryId   String    @db.ObjectId
  country     Country   @relation(fields: [countryId], references: [id])
  logo        String?
  website     String?
  city        String?
  description String?
  ranking     Int?
  status      String    @default("ACTIVE")
  courses     Course[]
  applications Application[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([countryId])
  @@index([status])
}

model Course {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  universityId    String    @db.ObjectId
  university      University @relation(fields: [universityId], references: [id])
  name            String
  degreeLevel     String // DIPLOMA | BACHELOR | MASTER | PHD | OTHER
  duration        String?
  tuitionFee      Float?
  currency        String    @default("EUR")
  description      String?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  intakes         Intake[]
  applications    Application[]

  @@index([universityId])
  @@index([degreeLevel])
}

model Intake {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String    @db.ObjectId
  course      Course    @relation(fields: [courseId], references: [id])
  name        String    // e.g. "Fall 2026"
  month       Int       // 1–12
  year        Int
  deadline    DateTime?
  status      String    @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([courseId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Applications & Documents
// ─────────────────────────────────────────────

model Application {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  applicationNumber String   @unique
  studentId        String    @db.ObjectId
  student          Student   @relation(fields: [studentId], references: [id])
  countryId        String    @db.ObjectId
  country          Country   @relation(fields: [countryId], references: [id])
  universityId     String?   @db.ObjectId
  university       University? @relation(fields: [universityId], references: [id])
  courseId         String?   @db.ObjectId
  course           Course?   @relation(fields: [courseId], references: [id])
  stageKey         String    @default("LEAD")
  status           String    @default("NEW")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  documents        Document[]
  tasks            Task[]
  visaApplications VisaApplication[]
  appointments     Appointment[]
  payments         Payment[]
  invoices         Invoice[]

  @@index([studentId])
  @@index([stageKey])
}

model Document {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String    @db.ObjectId
  student     Student   @relation(fields: [studentId], references: [id])
  applicationId String? @db.ObjectId
  application Application? @relation(fields: [applicationId], references: [id])
  name        String
  fileUrl     String?
  fileName    String?
  mimeType    String?
  fileSize    Int?
  status      String    @default("REQUESTED") // REQUESTED | UPLOADED | UNDER_REVIEW | APPROVED | REJECTED
  reviewNote  String?
  uploadedAt  DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([studentId])
  @@index([status])
}

model Task {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  studentId    String?   @db.ObjectId
  student      Student?  @relation(fields: [studentId], references: [id])
  applicationId String? @db.ObjectId
  application  Application? @relation(fields: [applicationId], references: [id])
  assignedToId String?   @db.ObjectId // employee userId
  priority     String    @default("MEDIUM")
  status       String    @default("TODO") // TODO | IN_PROGRESS | COMPLETED | CANCELLED
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId])
  @@index([assignedToId])
  @@index([status])
}

model Conversation {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId String    @db.ObjectId
  student   Student   @relation(fields: [studentId], references: [id])
  employeeId String?  @db.ObjectId
  employee  Employee? @relation(fields: [employeeId], references: [id])
  subject   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages Message[]

  @@index([studentId])
}

model Message {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String   @db.ObjectId // user id
  body           String
  readAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  action    String
  entity    String
  entityId  String?  @db.ObjectId
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
}

// ─────────────────────────────────────────────
// Visa, Appointments, Finance
// ─────────────────────────────────────────────

model VisaApplication {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  applicationId   String       @db.ObjectId
  application     Application  @relation(fields: [applicationId], references: [id])
  visaType        String?
  stage           String       @default("PREPARATION") // PREPARATION | SUBMITTED | BIOMETRICS | INTERVIEW | PROCESSING | APPROVED | REFUSED
  submittedAt     DateTime?
  biometricsAt    DateTime?
  interviewAt     DateTime?
  decisionAt      DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([applicationId])
  @@index([stage])
}

model Appointment {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String    @db.ObjectId
  student         Student   @relation(fields: [studentId], references: [id])
  applicationId   String?   @db.ObjectId
  application     Application? @relation(fields: [applicationId], references: [id])
  employeeId      String?   @db.ObjectId
  employee        Employee? @relation(fields: [employeeId], references: [id])
  type            String    // COUNSELING | DOCUMENT_REVIEW | VISA_INTERVIEW | BIOMETRICS | OTHER
  title           String
  scheduledAt     DateTime
  durationMinutes Int       @default(30)
  location        String?
  status          String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | RESCHEDULED
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([studentId])
  @@index([employeeId])
  @@index([scheduledAt])
  @@index([status])
}

model Payment {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId          String    @db.ObjectId
  student            Student   @relation(fields: [studentId], references: [id])
  applicationId      String?   @db.ObjectId
  application        Application? @relation(fields: [applicationId], references: [id])
  invoiceId          String?   @db.ObjectId
  amount             Float
  currency           String    @default("EUR")
  paymentMethod      String    @default("OTHER") // CASH | BANK_TRANSFER | CARD | OTHER
  transactionReference String?
  paymentDate        DateTime?
  status             String    @default("PENDING") // PENDING | PAID | REFUNDED | CANCELLED
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([studentId])
  @@index([status])
}

model Invoice {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String    @unique
  studentId     String    @db.ObjectId
  student       Student   @relation(fields: [studentId], references: [id])
  applicationId String?   @db.ObjectId
  application   Application? @relation(fields: [applicationId], references: [id])
  amount        Float
  currency      String    @default("EUR")
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  status        String    @default("ISSUED") // DRAFT | ISSUED | PAID | OVERDUE | CANCELLED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([studentId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Student academic & English proficiency records + Notes
// ─────────────────────────────────────────────

model AcademicRecord {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String   @db.ObjectId
  student        Student  @relation(fields: [studentId], references: [id])
  level          String // SSC | HSC | DIPLOMA | BACHELOR | MASTER | PHD | OTHER
  institution    String
  group          String?
  subject        String?
  passingYear    Int?
  result         String? // GPA / grade — free-text because grading scales vary
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId])
}

model EnglishProficiency {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String   @db.ObjectId
  student        Student  @relation(fields: [studentId], references: [id])
  testType       String // IELTS | TOEFL | PTE | DUOLINGO | OTHER
  overallScore   Float?
  readingScore   Float?
  writingScore   Float?
  listeningScore Float?
  speakingScore  Float?
  testDate       DateTime?
  expiryDate     DateTime?
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId])
}

model Note {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String   @db.ObjectId
  student     Student  @relation(fields: [studentId], references: [id])
  authorId    String   @db.ObjectId
  body        String
  visibility  String   @default("INTERNAL") // INTERNAL | STUDENT
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([authorId])
}
